{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "current_status": {
            "enum": [
              "raw_ready",
              "process_blocked",
              "process_review",
              "account_review",
              "account_blocked",
              "balance_review",
              "balance_blocked",
              "categorize_ready",
              "categorize_blocked",
              "categorize_review",
              "write_ready",
              "write_blocked",
              "final_review",
              "done"
            ]
          },
          "parsed_group": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "user_input_required": {
            "type": "boolean"
          },
          "manual_resolution_required": {
            "type": "boolean"
          },
          "sources": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "source_fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "process_attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "last_process_failure_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "source_fingerprint"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "session_id",
          "current_status",
          "parsed_group",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "groups"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-bean.local/schemas/v1/status"
}
