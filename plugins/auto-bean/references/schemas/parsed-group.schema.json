{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "group_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "statements": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://auto-bean.local/schemas/v2/parsed",
        "type": "object",
        "required": [
          "schema_version",
          "extraction_state",
          "source_file",
          "source_fingerprint",
          "source_format",
          "statement_metadata",
          "extracted_records",
          "review"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "document_kind": {
            "enum": [
              "statement",
              "transaction_export"
            ]
          },
          "parse_run_id": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_format": {
            "enum": [
              "pdf",
              "csv",
              "xlsx",
              "xls"
            ]
          },
          "parser": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "parsed_at": {
            "type": "string",
            "format": "date-time"
          },
          "statement_metadata": {
            "type": "object",
            "required": [
              "accounts"
            ],
            "properties": {
              "accounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "account_id"
                  ],
                  "properties": {
                    "account_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "account_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "primary_currency": {
                      "type": "string",
                      "minLength": 1
                    },
                    "opening_balance": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "date",
                            "amount",
                            "currency"
                          ],
                          "properties": {
                            "date": {
                              "type": "string",
                              "format": "date"
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                            },
                            "currency": {
                              "type": "string",
                              "minLength": 1
                            },
                            "source_reference": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "closing_balance": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "date",
                            "amount",
                            "currency"
                          ],
                          "properties": {
                            "date": {
                              "type": "string",
                              "format": "date"
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                            },
                            "currency": {
                              "type": "string",
                              "minLength": 1
                            },
                            "source_reference": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "available_balance": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "date",
                            "amount",
                            "currency"
                          ],
                          "properties": {
                            "date": {
                              "type": "string",
                              "format": "date"
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                            },
                            "currency": {
                              "type": "string",
                              "minLength": 1
                            },
                            "source_reference": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reported_record_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "account_owner": {
                      "type": "string"
                    },
                    "account_type": {
                      "type": "string"
                    },
                    "institution_name": {
                      "type": "string"
                    },
                    "account_number": {
                      "type": "string"
                    },
                    "review": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "enum": [
                            "proposed",
                            "confirmed",
                            "needs_input"
                          ]
                        },
                        "ledger_account": {
                          "type": "string"
                        },
                        "rationale": {
                          "type": "string"
                        },
                        "suggestions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "answer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "proposed_directives": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "reconciliation": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": "string",
                                "format": "date"
                              },
                              "currency": {
                                "type": "string"
                              },
                              "ledger_amount": {
                                "type": "string",
                                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                              },
                              "difference": {
                                "type": "string",
                                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                              },
                              "provenance": {
                                "type": "string"
                              },
                              "state": {
                                "enum": [
                                  "matched",
                                  "mismatch",
                                  "unavailable"
                                ]
                              }
                            },
                            "required": [
                              "date",
                              "currency",
                              "provenance",
                              "state"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "state",
                        "rationale"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "statement_period": {
                "type": "object",
                "required": [
                  "start_date",
                  "end_date"
                ],
                "properties": {
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "additionalProperties": false
              },
              "institution_name": {
                "type": "string"
              },
              "statement_name": {
                "type": "string"
              },
              "issued_date": {
                "type": "string",
                "format": "date"
              },
              "account_owner": {
                "type": "string"
              },
              "account_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "extracted_records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "record_id",
                "source_reference",
                "account_id",
                "transaction_date",
                "description",
                "amount",
                "currency"
              ],
              "properties": {
                "record_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "source_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "account_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "transaction_date": {
                  "type": "string",
                  "format": "date"
                },
                "value_date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "type": "string"
                },
                "amount": {
                  "type": "string",
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                },
                "currency": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "payee": {
                  "type": "string"
                },
                "review": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "proposed",
                        "confirmed",
                        "needs_input"
                      ]
                    },
                    "postings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "account": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "string",
                            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "cost": {
                            "type": "string"
                          },
                          "price": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "account",
                          "amount",
                          "currency"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "rationale": {
                      "type": "string"
                    },
                    "suggestions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "findings": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "likely_transfer",
                          "possible_future_transfer",
                          "possible_duplicate",
                          "unbalanced",
                          "currency_risk"
                        ]
                      }
                    },
                    "disposition": {
                      "enum": [
                        "post",
                        "existing_duplicate",
                        "paired_transfer",
                        "hold"
                      ]
                    },
                    "linked_records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "source_file": {
                            "type": "string"
                          },
                          "account_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                          },
                          "record_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                          }
                        },
                        "required": [
                          "source_file",
                          "account_id",
                          "record_id"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "existing_transaction": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "path",
                        "line"
                      ],
                      "additionalProperties": false
                    },
                    "posting_owner": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "postings",
                    "rationale",
                    "disposition"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "extraction_state": {
            "enum": [
              "pending",
              "running",
              "failed",
              "complete"
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "processing": {
                "type": "object",
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "outcome": {
                    "enum": [
                      "pending",
                      "running",
                      "failed",
                      "complete"
                    ]
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "failure_reason": {
                    "type": "string"
                  },
                  "needs_input": {
                    "type": "boolean"
                  },
                  "suggestions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failure_code": {
                    "enum": [
                      "tool_timeout",
                      "transient_io_failure",
                      "parser_crash",
                      "malformed_parser_output",
                      "unsupported_format",
                      "encrypted_or_unreadable_source",
                      "textless_pdf",
                      "missing_source",
                      "tool_unavailable"
                    ]
                  }
                },
                "required": [
                  "attempts",
                  "outcome",
                  "warnings",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "approval": {
                "type": "object",
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "approved_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "origin": {
                    "enum": [
                      "panel"
                    ]
                  }
                },
                "required": [
                  "digest",
                  "approved_at",
                  "origin"
                ],
                "additionalProperties": false
              },
              "validation": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "passed",
                      "failed"
                    ]
                  },
                  "stage": {
                    "enum": [
                      "review",
                      "written"
                    ]
                  },
                  "checked_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "ledger_hashes": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "records_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "balances": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "account_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                        },
                        "date": {
                          "type": "string",
                          "format": "date"
                        },
                        "currency": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string",
                          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                        },
                        "actual": {
                          "type": "string",
                          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
                        },
                        "state": {
                          "enum": [
                            "matched",
                            "mismatch"
                          ]
                        }
                      },
                      "required": [
                        "account_id",
                        "date",
                        "currency",
                        "expected",
                        "actual",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "state",
                  "stage",
                  "checked_at",
                  "digest",
                  "ledger_hashes",
                  "records_checked",
                  "balances",
                  "errors"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "processing"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "extraction_state": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "required": [
                "parse_run_id",
                "parser",
                "parsed_at",
                "document_kind"
              ]
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "group_id",
    "statements"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-bean.local/schemas/parsed-group"
}
